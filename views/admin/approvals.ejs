<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Approvals - MediCare</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <script src="/script.js"></script>
</head>
<body class="bg-light">
  <div class="container-fluid min-vh-100 d-flex flex-column">
    <header class="bg-primary text-white py-4">
      <div class="container-fluid">
        <div class="row align-items-center">
          <div class="col">
            <h1 class="h3 fw-bold mb-0">User Approvals</h1>
          </div>
          <div class="col-auto">
            <div class="settings-icon me-3" onclick="window.location.href='/admin/dashboard'">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
              </svg>
            </div>
            <div class="user-icon" onclick="toggleDropdown()">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
              </svg>
            </div>
            <div class="dropdown" id="userDropdown">
              <p class="mb-2 fw-semibold">Admin</p>
              <a href="/logout" class="btn btn-sm btn-outline-light w-100">Logout</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow-1 py-4">
      <div class="container-fluid">
        <div class="row">
          <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
              <h2 class="h4 fw-bold mb-0">Pending User Approvals</h2>
              <a href="/admin/dashboard" class="btn btn-outline-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                  <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </svg>
                Back to Dashboard
              </a>
            </div>

            <div class="card shadow-sm">
              <div class="card-body">
                <% if (users && users.length === 0) { %>
                  <div class="alert alert-info" role="alert">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                    No pending users to approve.
                  </div>
                <% } else { %>
                  <div class="table-responsive">
                    <table class="table table-hover">
                      <thead class="table-dark">
                        <tr>
                          <th>Username</th>
                          <th>Role</th>
                          <th>Status</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% users.forEach(u => { %>
                          <tr>
                            <td class="fw-semibold"><%= u.username %></td>
                            <td>
                              <span class="badge bg-secondary"><%= u.role %></span>
                            </td>
                            <td>
                              <span class="badge <%= u.status === 'pending' ? 'bg-warning text-dark' : 'bg-success' %>">
                                <%= u.status.charAt(0).toUpperCase() + u.status.slice(1) %>
                              </span>
                            </td>
                            <td>
                              <% if (u.status === 'pending') { %>
                                <form action="/admin/approve/<%= u.id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to approve this user?')">
                                  <button type="submit" class="btn btn-sm btn-success">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                    </svg>
                                    Approve
                                  </button>
                                </form>
                              <% } else { %>
                                <span class="text-success fw-semibold">
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                  </svg>
                                  Approved
                                </span>
                              <% } %>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="bg-dark text-white text-center py-3 mt-auto">
      <div class="container">
        <p class="mb-0">&copy; 2025 MediCare. All rights reserved.</p>
      </div>
    </footer>
  </div>

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
