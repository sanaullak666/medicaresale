<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - MediCare</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
  <script src="/script.js"></script>
</head>
<body>
  <div class="container-fluid p-0">
    <!-- Enhanced Header -->
    <header>
      <div class="container-fluid">
        <div class="row align-items-center">
          <div class="col">
            <h1 class="h3 fw-bold mb-0">Admin Panel</h1>
          </div>
          <div class="col-auto">
            <div class="settings-icon me-3" onclick="window.location.href='/admin/approvals'">
              <i class="fas fa-cog"></i>
            </div>
            <div class="user-icon" onclick="toggleDropdown()">
              <i class="fas fa-user"></i>
            </div>
            <div class="dropdown" id="userDropdown">
              <p class="mb-2 fw-semibold">Admin</p>
              <a href="/admin/dashboard" class="btn btn-sm btn-outline-light w-100 mb-1">Dashboard</a>
              <a href="/admin/orders" class="btn btn-sm btn-outline-light w-100 mb-1">Manage Orders</a>
              <a href="/change-password" class="btn btn-sm btn-outline-light w-100 mb-1">Change Password</a>
              <a href="/logout" class="btn btn-sm btn-outline-light w-100">Logout</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
              <h2 class="h4 fw-bold mb-0">Medicines Management</h2>
              <div>
                <a href="/admin/orders" class="btn btn-info me-2">
                  <i class="fas fa-shopping-cart me-2"></i>
                  Manage Orders
                </a>
                <a href="/admin/add" class="btn btn-primary">
                  <i class="fas fa-plus me-2"></i>
                  Add New Medicine
                </a>
              </div>
            </div>

            <div class="table-container">
              <form action="/admin/dashboard" method="GET" class="mb-4">
                <div class="search-container">
                  <input type="text" class="search-input" id="search" name="search" placeholder="Search by medicine name..." value="<%= search %>">
                  <button type="submit" class="search-btn">
                    <i class="fas fa-search"></i>
                  </button>
                </div>
              </form>

              <% if (medicines.length === 0) { %>
                <div class="alert alert-warning" role="alert">
                  <i class="fas fa-exclamation-triangle me-2"></i>
                  No medicines added yet.
                </div>
              <% } else { %>
                <table>
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Dosage</th>
                      <th>Price</th>
                      <th>Expiry Date</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% medicines.forEach(m => { %>
                      <tr class="<%= m.status === 'expired' ? 'table-danger' : '' %>">
                        <td class="fw-semibold"><%= m.name %></td>
                        <td><%= m.dosage %></td>
                        <td class="fw-bold text-primary">₹<%= m.price %></td>
                        <td><%= new Date(m.expiry_date).toLocaleDateString() %></td>
                        <td>
                          <span class="status <%= m.status %>">
                            <%= m.status.charAt(0).toUpperCase() + m.status.slice(1) %>
                          </span>
                        </td>
                        <td>
                          <div class="actions">
                            <a href="/admin/edit/<%= m.id %>" class="btn btn-sm btn-outline-primary">
                              <i class="fas fa-edit"></i>
                              Edit
                            </a>
                            <form action="/admin/delete/<%= m.id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this medicine?')">
                              <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i>
                                Delete
                              </button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <div class="container">
        <p class="mb-0">&copy; 2025 MediCare. All rights reserved.</p>
      </div>
    </footer>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
